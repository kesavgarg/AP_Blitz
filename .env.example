# Database
DATABASE_URL="postgresql://apblitz:apblitz@localhost:5433/apblitz"

# Auth — generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"

# Founder account created on first seed
FOUNDER_EMAIL="kesavgarg@gmail.com"
FOUNDER_NAME="Kesav Garg"
FOUNDER_PASSWORD="change-me"

# Leave false. Demo fake team members inflate admin stats.
SEED_DEMO="false"

# File uploads
UPLOAD_DIR="./uploads"

# Email (leave blank to log emails to the console in development)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="AP Blitz <hello@apblitz.org>"
