# Database
DATABASE_URL="postgresql://apblitz:apblitz@localhost:5433/apblitz"

# Auth — generate with: openssl rand -base64 48
# Must be at least 32 characters. The app refuses known placeholders.
AUTH_SECRET="replace-with-a-long-random-string"
APP_URL="http://localhost:3000"

# Founder account created on first seed. Seed refuses "change-me" and short passwords.
# Seed does not overwrite an existing founder password unless SEED_RESET_FOUNDER_PASSWORD=1.
FOUNDER_EMAIL="kesavgarg@gmail.com"
FOUNDER_NAME="Kesav Garg"
FOUNDER_PASSWORD=""

# Shared rate limits (Upstash Redis). Required in production so limits survive across instances.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Private object storage for uploads (Vercel Blob). Required on Vercel.
BLOB_READ_WRITE_TOKEN=""

# Leave false. Demo fake team members inflate admin stats.
SEED_DEMO="false"

# File uploads
UPLOAD_DIR="./uploads"

# Email (leave blank to log emails to the console in development)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="AP Blitz <hello@apblitz.org>"

# Web push (phone notifications). Generate with:
# npx web-push generate-vapid-keys
# Push stays off until all three are set. In-app notifications still work without them.
# VAPID_SUBJECT must be a mailto: or https: contact.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@apblitz.org"

# Instagram for the welcome popup is saved in Admin → Settings, not here.
